{
  "name": "crowd-control-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Development-only Roblox round simulator for Crowd Control",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "simulate": "node --env-file=.env dist/simulate.js",
    "test": "npm run build && node --test dist/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.5",
    "typescript": "^5.8.3"
  }
}
